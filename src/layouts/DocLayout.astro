---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const navItems = [
  { title: 'はじめに', links: [
    { text: "「カナデ」はこんな言語です！", href: '/docs/intro' },
  ]},
  { title: '基本文法チュートリアル', links: [
    { text: '1. 値を入れる (変数)', href: '/docs/tutorial/1-variables' },
    { text: '2. 計算する (演算)', href: '/docs/tutorial/2-math' },
    { text: '3. 文字を扱う (文字列)', href: '/docs/tutorial/3-strings' },
    { text: '4. 条件分岐（もし〜なら）', href: '/docs/tutorial/4-conditions' },
    { text: '5. スイッチ (条件分岐)', href: '/docs/tutorial/5-switch' },
    { text: '6. 集めて入れる (リスト、辞書)', href: '/docs/tutorial/6-collections' },
    { text: '7. 繰り返す (繰り返し文)', href: '/docs/tutorial/7-loops' },
    { text: '8. 関数（機能を作る）', href: '/docs/tutorial/8-functions' },
    { text: '9. エラー処理 (例外処理)', href: '/docs/tutorial/9-errors' },
    { text: '10. 標準ライブラリ（道具箱）', href: '/docs/tutorial/10-stdlib' },
    { text: '11. 標準ライブラリ2（もっと多くの道具）', href: '/docs/tutorial/11-stdlib-more' },
    { text: '12. ファイルを扱おう（実行器だけ）', href: '/docs/tutorial/12-files' },
  ]},
  { title: 'オブジェクト指向文法', links: [
    { text: '1. クラス（設計図）', href: '/docs/oop/1-classes' },
    { text: '2. アクセス制御 (秘密と公開)', href: '/docs/oop/2-access-modifiers' },
    { text: '3. 継承 (親から受け継ぐ)', href: '/docs/oop/3-inheritance' },
    { text: '4. インターフェース (骨組みの約束)', href: '/docs/oop/4-interfaces' },
  ]},
  { title: 'デザインパターン (応用)', links: [
    { text: '1. シングルトン (Singleton)', href: '/docs/patterns/1-singleton' },
    { text: '2. ファクトリー (Factory)', href: '/docs/patterns/2-factory' },
    { text: '3. ストラテジー (Strategy)', href: '/docs/patterns/3-strategy' },
    { text: '4. オブザーバー (Observer)', href: '/docs/patterns/4-observer' },
    { text: '5. ビルダー (Builder)', href: '/docs/patterns/5-builder' },

      { text: '6. アダプター (Adapter)', href: '/docs/patterns/6-adapter' },
      { text: '7. デコレーター (Decorator)', href: '/docs/patterns/7-decorator' },
      { text: '8. ステート (State)', href: '/docs/patterns/8-state' },
      { text: '9. コマンド (Command)', href: '/docs/patterns/9-command' },
      { text: '10. ファサード (Facade)', href: '/docs/patterns/10-facade' },
  ]},
  { title: '技術仕様 (Spec)', links: [
    { text: '1. 言語概要および文法', href: '/docs/tech-spec/1-overview' },
    { text: '2. 構文木(AST) 構造', href: '/docs/tech-spec/2-ast' },
    { text: '3. 実行機(Interpreter)とランタイム', href: '/docs/tech-spec/3-runtime' },
  ]}
];
---

<Layout title={`${frontmatter.title} | カナデ(Kanade) 言語`} customMaxWidth="max-w-6xl">
  <div class="doc-shell flex flex-col md:flex-row gap-12 lg:gap-16 mt-6">
    <aside class="doc-aside w-full md:w-56 shrink-0 border-b md:border-b-0 border-rule pb-8 md:pb-0">
      <nav class="md:sticky md:top-10 md:max-h-[calc(100vh-5rem)] md:overflow-y-auto space-y-9 md:pr-2" aria-label="目次">
        {navItems.map((section) => (
          <div>
            <h4 class="font-display font-bold text-ink mb-3 text-[15px]">{section.title}</h4>
            <ul class="border-l border-rule">
              {section.links.map((link) => {
                const isActive = Astro.url.pathname === link.href || Astro.url.pathname === link.href + '/';
                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive ? 'page' : undefined}
                      class={`block text-sm py-1.5 pl-4 -ml-px border-l-2 transition-colors ${isActive ? 'border-verb text-ink font-semibold' : 'border-transparent text-ink-soft hover:text-ink hover:border-ink-faint'}`}
                    >
                      {link.text}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}

        <button id="open-side-playground" class="hj-run solid w-full py-2.5">
          直接実行してみる
        </button>
      </nav>
    </aside>

    <article class="prose max-w-none flex-grow min-w-0 pb-24 doc-article">
      <h1 class="!mt-0">{frontmatter.title}</h1>
      <p class="text-xl text-ink-soft !mb-12 !mt-0 leading-relaxed border-b border-rule pb-10">{frontmatter.description}</p>
      <slot />
    </article>
  </div>

  <!-- Side Playground Overlay -->
  <div id="side-playground-drawer" class="fixed top-0 right-0 w-0 h-full bg-white border-l border-rule z-40 transition-all duration-300 flex flex-col overflow-hidden">
    <div class="hj-panel-head shrink-0 !py-2.5" style="border-radius:0">
      <span class="hj-tag font-semibold text-ink">プレイグラウンド</span>
      <div class="flex gap-2">
        <button id="side-run-btn" class="hj-run solid">実行</button>
        <button id="side-close-btn" class="hj-run">閉じる</button>
      </div>
    </div>
    <div id="side-editor" class="flex-grow w-full overflow-hidden flex flex-col min-h-0"></div>
    <div class="hj-out h-[40%] flex flex-col shrink-0">
      <div class="hj-out-head shrink-0">結果</div>
      <pre id="side-output" class="p-4 text-[13.5px] whitespace-pre-wrap overflow-y-auto flex-grow m-0">コードを書いて「実行」ボタンを押してください。</pre>
    </div>
  </div>

  <script>
    import { runKanade } from '../utils/kanade';
    import { EditorView, basicSetup } from "codemirror";
    import { kanadeLanguage } from '../utils/kanade/cm-language';
    import { kanadeTheme } from '../utils/kanade/cmTheme';
      import { kanadeLinter, kanadeAutocomplete } from '../utils/kanade/kanadeLSP';

    document.addEventListener("DOMContentLoaded", () => {

const createInputCallback = (outputContainer) => (promptText) => {
  return new Promise((resolve) => {
    if (!outputContainer) { resolve(""); return; }
    const promptSpan = document.createElement("span");
    promptSpan.innerText = promptText;
    promptSpan.className = "hj-prompt";
    
    const inputWrapper = document.createElement("span");
    inputWrapper.className = "relative inline-block ml-2";
    
    const inputEl = document.createElement("input");
    inputEl.type = "text";
    inputEl.className = "hj-input";
    inputEl.autocomplete = "off";
    
    inputWrapper.appendChild(inputEl);
    outputContainer.appendChild(promptSpan);
    outputContainer.appendChild(inputWrapper);
    
    outputContainer.scrollTop = outputContainer.scrollHeight;
    inputEl.focus();
    
    inputEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = inputEl.value;
        inputWrapper.innerHTML = "";
        const textSpan = document.createElement("span");
        textSpan.innerText = val;
        inputWrapper.appendChild(textSpan);
        outputContainer.appendChild(document.createTextNode("\n"));
        resolve(val);
      }
    });
  });
};

      /* --- Side Playground Logic --- */
      const openBtn = document.getElementById('open-side-playground');
      const closeBtn = document.getElementById('side-close-btn');
      const drawer = document.getElementById('side-playground-drawer');
      const sideRunBtn = document.getElementById('side-run-btn');
      const sideOutput = document.getElementById('side-output');
      const sideEditorContainer = document.getElementById('side-editor');
      
      let sideEditorView = null;

      if (openBtn && closeBtn && drawer && sideEditorContainer) {
        const initSideEditor = () => {
          if (sideEditorView) return;
          const savedCode = sessionStorage.getItem('kanade-playground-code') || "『名前』を【文字列】の「田中」にしよう\n枠「こんにちは、{『名前』}さん！」を出力しよう";
          sideEditorView = new EditorView({
            doc: savedCode,
            extensions: [
              basicSetup,
              kanadeLanguage,
              kanadeLinter,
              kanadeAutocomplete,
              EditorView.lineWrapping,
              kanadeTheme({ height: "100%" }),
              EditorView.updateListener.of((v) => {
                if (v.docChanged) {
                  sessionStorage.setItem('kanade-playground-code', v.state.doc.toString());
                }
              })
            ],
            parent: sideEditorContainer
          });
        };

        const openDrawer = (animate = true) => {
          if (!animate) {
            drawer.style.transition = 'none';
            document.body.style.transition = 'none';
          }
          drawer.classList.remove('w-0');
          drawer.classList.add('w-full', 'md:w-1/2');
          document.documentElement.classList.add('drawer-open');
          document.body.style.width = window.innerWidth > 768 ? '50%' : '100%';
          
          if (!animate) {
            void drawer.offsetWidth; // force reflow
            drawer.style.transition = '';
            document.body.style.transition = '';
          } else {
            document.body.style.transition = 'width 0.3s ease-in-out';
          }
          
          initSideEditor();
          sessionStorage.setItem('kanade-playground-open', 'true');
        };

        const closeDrawer = () => {
          drawer.classList.add('w-0');
          drawer.classList.remove('w-full', 'md:w-1/2');
          document.documentElement.classList.remove('drawer-open');
          document.body.style.width = '100%';
          sessionStorage.setItem('kanade-playground-open', 'false');
        };

        openBtn.addEventListener('click', () => openDrawer(true));
        closeBtn.addEventListener('click', closeDrawer);

        // Check initial state
        if (sessionStorage.getItem('kanade-playground-open') === 'true') {
          openDrawer(false);
        }


        // Run button logic
        sideRunBtn?.addEventListener('click', async () => {
          if (!sideEditorView) return;
          sideRunBtn.innerText = '実行中...';
          sideOutput.innerText = '';
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            sideOutput.innerText += msg;
            sideOutput.scrollTop = sideOutput.scrollHeight;
            printedSomething = true;
          };
          
          try {
            const code = sideEditorView.state.doc.toString();
            const result = await runKanade(code, createInputCallback(sideOutput), outputCallback);
            if (!printedSomething && !result) {
               sideOutput.innerText += '\n(あっ、出力された結果がありません。「出力しよう」を使ってみてください。)';
            }
          } catch (err) {
            sideOutput.innerText += "\n" + String(err);
          } finally {
            sideRunBtn.innerText = '実行';
          }
        });

        // Handle resize window restoring 50% width if open
        window.addEventListener('resize', () => {
          if (drawer.classList.contains('md:w-1/2')) {
            document.body.style.width = window.innerWidth > 768 ? '50%' : '100%';
          }
        });
      }

      /* --- Inline Interactive Blocks --- */
      // Find all code blocks inside the article
      const codeBlocks = document.querySelectorAll('.doc-article pre[data-language="plaintext"], .doc-article pre[data-language="kanade"]');
      
      codeBlocks.forEach((pre, index) => {
        // Extract raw text
        let rawCode = "";
        const lines = pre.querySelectorAll('.line');
        if (lines.length > 0) {
          rawCode = Array.from(lines).map(l => l.textContent).join('\n');
        } else {
          rawCode = pre.textContent || "";
        }
        rawCode = rawCode.trim();

        // Create container for interactive block
        const container = document.createElement('div');
        container.className = 'not-prose hj-panel my-8';

        // Header
        const header = document.createElement('div');
        header.className = 'hj-panel-head';

        const label = document.createElement('span');
        label.className = 'hj-tag';
        label.textContent = `例題 ${index + 1}`;

        const runBtn = document.createElement('button');
        runBtn.className = 'hj-run';
        runBtn.innerHTML = `実行`;

        header.appendChild(label);
        header.appendChild(runBtn);

        // Editor area
        const editorDiv = document.createElement('div');
        editorDiv.className = 'w-full';

        // Output area
        const outputWrapper = document.createElement('div');
        outputWrapper.className = 'hidden flex-col hj-out';

        const outputHeader = document.createElement('div');
        outputHeader.className = 'hj-out-head';
        outputHeader.textContent = '結果';

        const outputPre = document.createElement('pre');
        outputPre.className = 'p-4 text-[13.5px] whitespace-pre-wrap m-0';

        outputWrapper.appendChild(outputHeader);
        outputWrapper.appendChild(outputPre);

        container.appendChild(header);
        container.appendChild(editorDiv);
        container.appendChild(outputWrapper);

        // Replace <pre> with our interactive container
        pre.parentNode?.replaceChild(container, pre);

        // Init CodeMirror
        const editorView = new EditorView({
          doc: rawCode,
          extensions: [
            basicSetup,
              kanadeLanguage,
              kanadeLinter,
              kanadeAutocomplete,
            EditorView.lineWrapping,
            kanadeTheme({ maxHeight: "400px" })
          ],
          parent: editorDiv
        });

        // Event logic
        runBtn.addEventListener('click', async () => {
          runBtn.innerText = '実行中...';
          outputWrapper.classList.remove('hidden');
          outputWrapper.classList.add('flex');
          outputPre.innerText = '';
          
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            outputPre.innerText += msg;
            outputPre.scrollTop = outputPre.scrollHeight;
            printedSomething = true;
          };

          try {
            const code = editorView.state.doc.toString();
            const result = await runKanade(code, createInputCallback(outputPre), outputCallback);
            if (!printedSomething && !result) {
               outputPre.innerText += '\n(あっ、出力された結果がありません。「出力しよう」を使ってみてください。)';
            }
          } catch (err) {
            outputPre.innerText += "\n" + String(err);
          } finally {
            runBtn.innerHTML = '実行';
          }
        });
      });
    });
  </script>
</Layout>
