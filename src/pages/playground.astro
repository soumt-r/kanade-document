---
import Layout from '../layouts/Layout.astro';
---

<Layout title="プレイグラウンド | カナデ(Kanade) 言語" customMaxWidth="max-w-[1400px]">
  <div class="w-full flex flex-col h-[calc(100vh-220px)] mt-[-20px]">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-2xl font-bold tracking-tight">プレイグラウンド (Playground)</h1>
      <button 
        id="run-btn"
        class="bg-blue-600 text-white px-6 py-2 rounded-lg font-medium text-sm hover:bg-blue-700 transition-colors flex items-center gap-2 shadow-sm"
      >
        <span id="run-text">実行する</span>
        <svg id="run-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      </button>
    </div>

    <div class="flex flex-col md:flex-row gap-6 flex-grow min-h-0">
      <!-- Editor -->
      <div class="flex-1 flex flex-col min-h-0 shadow-lg rounded-xl border border-zinc-200 bg-white overflow-hidden">
        <div class="bg-zinc-50 border-b border-zinc-200 px-4 py-3 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
          <span class="ml-2 text-xs font-semibold text-zinc-400 font-mono">main.knd</span>
        </div>
        <div 
          id="editor-container" 
          class="flex-grow w-full overflow-hidden flex flex-col"
        ></div>
      </div>

      <!-- Output -->
      <div class="flex-1 flex flex-col min-h-0 shadow-lg rounded-xl border border-zinc-800 bg-[#1E1E1E] overflow-hidden">
        <div class="bg-[#2D2D2D] border-b border-zinc-700 px-4 py-3 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-zinc-500"></div>
          <div class="w-3 h-3 rounded-full bg-zinc-500"></div>
          <div class="w-3 h-3 rounded-full bg-zinc-500"></div>
          <span class="ml-2 text-xs font-semibold text-zinc-400 font-mono">Terminal - Kanade Runtime</span>
        </div>
        <div class="flex-grow w-full p-4 overflow-y-auto relative">
          <pre id="output" class="font-mono text-[14.5px] text-zinc-300 whitespace-pre-wrap leading-relaxed"></pre>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { runHaja } from '../utils/kanade';
    import { EditorView, basicSetup } from "codemirror";
    import { kanadeLanguage } from '../utils/kanade/cm-language';
      import { hajaLinter, hajaAutocomplete } from '../utils/kanade/hajaLSP';

    const defaultCode = `枠「こんにちは、世界！」を出力しよう`;

    document.addEventListener("DOMContentLoaded", () => {
      const runBtn = document.getElementById("run-btn");
      const runText = document.getElementById("run-text");
      const runSpinner = document.getElementById("run-spinner");
      const output = document.getElementById("output");
      
      if (output) output.innerText = "実行結果がここに表示されます。";

      const editorView = new EditorView({
        doc: defaultCode,
        extensions: [
          basicSetup,
          kanadeLanguage,
            hajaLinter,
            hajaAutocomplete,
          EditorView.lineWrapping,
          EditorView.theme({
            "&": { height: "100%", fontSize: "15.5px" },
            "&.cm-focused": { outline: "none" },
            ".cm-scroller": { fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace", overflow: "auto" },
            ".cm-gutters": { backgroundColor: "#fbfbfb", borderRight: "1px solid #f0f0f0", color: "#999" }
          })
        ],
        parent: document.getElementById("editor-container")!
      });

      // Run code
            runBtn?.addEventListener("click", async () => {
        if (runText) runText.innerText = "実行中...";
        runSpinner?.classList.remove("hidden");
        
        try {
          if (output) output.innerText = "";
          const code = editorView.state.doc.toString();
          
          let printedSomething = false;
          
          const outputCallback = (msg) => {
            if (output) {
              output.innerText += msg;
              output.scrollTop = output.scrollHeight;
              printedSomething = true;
            }
          };

          const inputCallback = (promptText) => {
            return new Promise((resolve) => {
              if (!output) { resolve(""); return; }
              const promptSpan = document.createElement("span");
              promptSpan.innerText = promptText;
              promptSpan.className = "text-yellow-400";
              
              const inputWrapper = document.createElement("span");
              inputWrapper.className = "relative inline-block ml-2";
              
              const inputEl = document.createElement("input");
              inputEl.type = "text";
              inputEl.className = "bg-transparent border-b border-yellow-400/50 outline-none text-white w-64 focus:border-yellow-400 transition-all";
              inputEl.autocomplete = "off";
              
              inputWrapper.appendChild(inputEl);
              output.appendChild(promptSpan);
              output.appendChild(inputWrapper);
              
              // Move cursor back to input
              output.scrollTop = output.scrollHeight;
              inputEl.focus();
              
              const onDone = () => {
                const val = inputEl.value;
                inputWrapper.innerHTML = "";
                const textSpan = document.createElement("span");
                textSpan.innerText = val;
                inputWrapper.appendChild(textSpan);
                output.appendChild(document.createTextNode("\n"));
                resolve(val);
              };
              
              inputEl.addEventListener("keydown", (e) => {
                if (e.key === "Enter") onDone();
              });
            });
          };

          const result = await runHaja(code, inputCallback, outputCallback);
          
          // Only show default message if literally nothing was printed via outputCallback OR return
          if (!printedSomething && !result) {
            if (output) output.innerText += '\n(あれ、出力された結果がありません。 "出力しよう"」を使ってみてください.)';
          }
        } catch (err) {
          if (output) output.innerText += "\n" + String(err);
        } finally {
          if (runText) runText.innerText = "実行する";
          runSpinner?.classList.add("hidden");
        }
      });
    });
  </script>
</Layout>
